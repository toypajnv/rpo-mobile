APP_NAME=РПО Сервер
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./data/rpo.db
# Production example: postgresql+psycopg://rpo:rpo_password@db:5432/rpo

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# file = save .eml locally, resend = send via Resend HTTPS API, smtp = optional fallback
MAIL_MODE=file
RESEND_API_KEY=
RESEND_FROM=РПО Сервер <rpo@rpo-mng.ru>
RESEND_API_URL=https://api.resend.com/emails

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=rpo@example.ru
SMTP_STARTTLS=true

# Incoming access-registry mailbox. It accepts the main XLSB registry and the UKZ XLSX stop-list.
STOP_MAIL_PROVIDER=resend
STOP_MAIL_POLL_SECONDS=60
STOP_RESEND_API_BASE=https://api.resend.com
# Exact inbound address shown in Resend: Receiving -> Receiving address.
# Example only: ostanovka@your-team-id.resend.app
STOP_RESEND_TO=
STOP_RESEND_SENDER=
STOP_RESEND_SUBJECT=Реестр остановок
STOP_RESEND_UKZ_SUBJECT=Стоп-лист УКЗ
STOP_RESEND_LIST_LIMIT=50
STOP_MAX_ATTACHMENT_MB=25

# Optional IMAP mode. Production Timeweb uses ostanovka@rpo-mng.ru.
STOP_IMAP_HOST=
STOP_IMAP_PORT=993
STOP_IMAP_USERNAME=
STOP_IMAP_PASSWORD=
STOP_IMAP_FOLDER=INBOX
STOP_IMAP_SENDER=*
STOP_IMAP_SUBJECT=Реестр остановок
STOP_IMAP_UKZ_SUBJECT=Стоп-лист УКЗ
STOP_IMAP_POLL_SECONDS=60

EXPORT_DIR=./data/exports
OUTBOX_DIR=./data/outbox
