APP_NAME=РПО Сервер
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./data/rpo.db
# Production example: postgresql+psycopg://rpo:rpo_password@db:5432/rpo

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# file = save .eml locally, resend = send via Resend HTTPS API, smtp = optional fallback
MAIL_MODE=file
RESEND_API_KEY=
RESEND_FROM=РПО Сервер <rpo@rpo-mng.ru>
RESEND_API_URL=https://api.resend.com/emails

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=rpo@example.ru
SMTP_STARTTLS=true

# Incoming mailbox for the stop registry XLSB file.
STOP_IMAP_HOST=
STOP_IMAP_PORT=993
STOP_IMAP_USERNAME=
STOP_IMAP_PASSWORD=
STOP_IMAP_FOLDER=INBOX
# Required security filters: importer stays disabled while either value is blank.
STOP_IMAP_SENDER=
STOP_IMAP_SUBJECT=Реестр остановок
STOP_IMAP_POLL_SECONDS=60

EXPORT_DIR=./data/exports
OUTBOX_DIR=./data/outbox
